# Copiez ce fichier en .env pour modifier l'environnement.

# Port publié sur votre poste. Passez à 5433 si un autre PostgreSQL utilise déjà 5432.
PG_PORT=5432

# Nombre de lignes de la table mesure. Pris en compte au premier démarrage
# uniquement : relancez ./scripts/reset.sh après l'avoir modifié.
#   200000   poste très peu puissant
#   1000000  valeur par défaut, celle des ateliers
#   10000000 pour sentir vraiment l'effet des index (chargement de 30 s à 2 min)
MESURES=1000000
